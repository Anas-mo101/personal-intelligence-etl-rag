{
    "name": "personal-intelligence-etl-rag",
    "version": "1.0.0",
    "description": "A high-performance, open-source ETL pipeline designed to ingest unstructured personal data (emails, calendar events, PDFs) and transform it into a Knowledge Graph for advanced Retrieval-Augmented Generation (RAG).",
    "main": "index.js",
    "scripts": {
        "start:prod": "NODE_ENV=prod node /usr/src/app/dist/index.js",
        "prisma:generate": "npx prisma --config ./src/config/prisma.config.ts generate",
        "prisma:push": "npx prisma --config ./src/config/prisma.config.ts db push",
        "prisma:seed": "npx prisma --config ./src/config/prisma.config.ts db seed",
        "build": "tsc -p .",
        "dev": "NODE_ENV=dev ts-node-dev --respawn --ignore-watch node_modules src/index.ts",
        "docker:run": "docker compose --project-name=app up",
        "docker:dev:run": "docker compose -f docker-compose.dev.yml --project-name=app up",
        "docker:build": "docker compose down && docker compose --project-name=app up --no-deps --build",
        "docker:dev:build": "docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml --project-name=app up --no-deps --build"
    },
    "keywords": [],
    "author": "anas.moelsebay@gmail.com",
    "license": "MIT",
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/multer": "^2.0.0",
        "prisma": "^6.19.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@namatery/multer-minio": "^1.1.2",
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^6.19.1",
        "axios": "^1.13.2",
        "bullmq": "^5.66.4",
        "cls-rtracer": "^2.6.3",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.22.1",
        "express-async-errors": "^3.1.1",
        "express-useragent": "^2.0.2",
        "helmet": "^8.1.0",
        "http-graceful-shutdown": "^3.1.15",
        "http-status": "^1.7.4",
        "ioredis": "^5.8.2",
        "lodash": "^4.17.21",
        "minio": "^8.0.6",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "pg": "^8.16.3",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.3",
        "rotating-file-stream": "^3.2.7",
        "uuid": "^13.0.0",
        "zod": "^4.3.5",
        "zod-validation-error": "^5.0.0"
    }
}
